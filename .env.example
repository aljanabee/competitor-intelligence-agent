# --- API ---------------------------------------------------------------
# Comma-separated keys clients send as X-API-Key. Empty = no auth (dev only!)
API_KEYS=change-me
MAX_CONCURRENT_JOBS=3
# local = SQLite + in-process jobs; azure = Blob + Storage queue (Azure Functions)
JOB_BACKEND=local

# Run everything on synthetic data (no keys, no cost) - good for demos/integration
MOCK_PROVIDERS=false

# --- Apify (website, Trustpilot, social, Google Maps discovery) --------
APIFY_TOKEN=
APIFY_RUN_TIMEOUT_S=600
CACHE_TTL_HOURS=24

# --- CVR system-til-system (free; request at cvrselvbetjening@erst.dk) -
CVR_USERNAME=
CVR_PASSWORD=

# --- LLM ----------------------------------------------------------------
LLM_PROVIDER=azure_openai            # azure_openai | anthropic
AZURE_OPENAI_ENDPOINT=               # https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=             # your model deployment name
AZURE_OPENAI_API_KEY=                # leave empty to use managed identity / az login
ANTHROPIC_API_KEY=                   # only if LLM_PROVIDER=anthropic
REPORT_LANGUAGE=da

# --- Request defaults (callers can override per request) ---------------
DEFAULT_RADIUS_KM=25
DEFAULT_MAX_COMPETITORS=5
DEFAULT_INDUSTRY_CODE_DIGITS=4
